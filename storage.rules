rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isStaff() {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'staff';
    }
    function validImage() {
      return request.resource.size < 2 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    match /maintenance/{userId}/{requestId} {
      allow read: if isAdmin() || isStaff() ||
        (request.auth != null && request.auth.uid == userId);
      allow write: if request.auth != null && request.auth.uid == userId && validImage();
    }

    match /grave-photos/{graveId}/{photoId} {
      allow read: if request.auth != null;
      allow write: if (isAdmin() || isStaff()) && validImage();
    }

    match /profiles/{userId}/{photoId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId && validImage();
    }

    match /payment-documents/{paymentId}/{fileId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('application/pdf|application/msword|application/vnd.openxmlformats-officedocument.wordprocessingml.document|image/(jpeg|png|webp)');
      allow delete: if isAdmin();
    }
  }
}
